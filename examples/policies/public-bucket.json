{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "ReadForEveryone", "Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::acme-assets/*" },
    { "Sid": "AnyAccountCanAssume", "Effect": "Allow", "Principal": { "AWS": "*" }, "Action": "sts:AssumeRole" }
  ]
}
